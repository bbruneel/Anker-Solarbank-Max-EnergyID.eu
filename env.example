# EnergyID API Configuration
# Create provisioning credentials at:
# https://help.energyid.eu/en/developer/incoming-webhooks/
ENERGYID_KEY=your_provisioning_key_here
ENERGYID_SECRET=your_provisioning_secret_here
ENERGYID_YOUR_DEVICE_ID=solarbank-max-ac
ENERGYID_YOUR_DEVICE_NAME=Anker Solarbank Max AC
ENERGYID_HELLO_URL=https://hooks.energyid.eu/hello
ENERGYID_WEBHOOK_URL=https://hooks.energyid.eu/webhook-in

# Comma-separated EnergyID webhook keys to send (incoming webhooks predefined keys).
# Supported values:
#   pv      - Solar photovoltaic production (cumulative, kWh)
#   bat     - Battery charging (cumulative, kWh)
#   bat-i   - Battery discharging (cumulative, kWh)
#   bat-soc - Battery state of charge (gauge, %)
#   pwr     - Grid offtake / import power (gauge, kW)
#   pwr-i   - Grid injection / export power (gauge, kW)
ENERGYID_WEBHOOK_KEYS=pv,bat,bat-i,bat-soc,pwr,pwr-i
# Example: battery metrics only
# ENERGYID_WEBHOOK_KEYS=bat,bat-i,bat-soc

# Offline reading queue / upload rate limiting (seconds)
# Minimum seconds between successful webhook POSTs (default 900 = Premium plan).
# Effective interval is max(this, last hello uploadInterval) unless override is true.
ENERGYID_UPLOAD_INTERVAL_SECONDS=900
# If true, ignore hello's uploadInterval and use ENERGYID_UPLOAD_INTERVAL_SECONDS only.
ENERGYID_UPLOAD_INTERVAL_OVERRIDE=false
# Keep stored readings (sent and pending) until payload ts is older than this (default 7 days).
ENERGYID_READING_RETENTION_SECONDS=604800

# Anker SOLIX Solarbank Max AC — local Modbus TCP
# Enable Modbus TCP in the Anker app:
# Device → Settings → Three-Party Control Settings → Modbus TCP
SOLARBANK_IP_ADDRESS=192.168.50.100
SOLARBANK_MODBUS_PORT=502
SOLARBANK_DEVICE_ID=1

# Log level (default: INFO)
ENERGYID_LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Log file path (default: /var/log/energyid-solarbank/energyid-solarbank.log)
ENERGYID_LOG_FILE=/var/log/energyid-solarbank/energyid-solarbank.log

# Enable console logging to stdout (default: false)
ENERGYID_CONSOLE_LOGGING=false  # Set to true to enable console output

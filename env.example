# EnergyID API Configuration
# Create provisioning credentials at:
# https://help.energyid.eu/en/developer/incoming-webhooks/
ENERGYID_KEY=your_provisioning_key_here
ENERGYID_SECRET=your_provisioning_secret_here
ENERGYID_YOUR_DEVICE_ID=solarbank-max-ac
ENERGYID_YOUR_DEVICE_NAME=Anker Solarbank Max AC
ENERGYID_HELLO_URL=https://hooks.energyid.eu/hello
ENERGYID_WEBHOOK_URL=https://hooks.energyid.eu/webhook-in

# Anker SOLIX Solarbank Max AC — local Modbus TCP
# Enable Modbus TCP in the Anker app:
# Device → Settings → Three-Party Control Settings → Modbus TCP
SOLARBANK_IP_ADDRESS=192.168.50.100
SOLARBANK_MODBUS_PORT=502
SOLARBANK_DEVICE_ID=1

# Log level (default: INFO)
ENERGYID_LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Log file path (default: /var/log/energyid/energyid.log)
ENERGYID_LOG_FILE=/var/log/energyid/energyid.log

# Enable console logging to stdout (default: false)
ENERGYID_CONSOLE_LOGGING=false  # Set to true to enable console output
